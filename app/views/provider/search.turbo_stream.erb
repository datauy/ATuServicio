<% op = "update" %>
<% if @page > 0 %>
  <% op = "append" %>
<% end %>
<% if @providers.length > 0 %>
    <%= turbo_stream.send(:"#{op}", "provider_list") do %>
    <% if @type == 'summary' %>
      <% @providers.each do |p| %>
        <%= render partial: '/provider/summary', locals: {provider: p} %>
      <% end %>
    <% else %>
    <div class="list" >
      <% @providers.keys.each do |key| %>
        <button data-action="click->compare#submitWithProvider" value="<%= key %>"><%= @providers[key] %></li>
      <% end %>
    </div>
    <% end %>
  <% end %>
<% else %>
  0
<% end %>