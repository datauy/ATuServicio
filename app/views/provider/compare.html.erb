<div class="providers" data-controller="compare" data-compare-ctype-value="compare" data-compare-pids-value="<%= @pids %>">
  <div class="header">
    <div class="tag page-tag tag-prestadores"><%= svg('house-medical.svg') %>Prestadores y servicios</div>
    <h1>Tomá una decisión informada</h1>
    <div class="page-description">Seleccioná hasta 3 prestadores y compará más de 120 indicadores. Ampliá las secciones usando la flecha o haciendo click en el título y navegá la información de sedes usando el mapa, o listado por departamento.</div>
    <input type="text" name="provider" data-action='keyup->compare#searchWrite' placeholder="Buscá prestadores por nombre"/>
    <%= turbo_frame_tag "provider_list" %>
  </div>
<% if @providers.length > 0 %>
  <div class="filters filters-mov">
    <%= image_tag('/images/filter.svg') %>
    <input type="text" name="datum" data-action='keyup->compare#searchWrite' placeholder="¿Demasiada información? Filtrá por palabra"/>
  </div>
  <div class="compare-header ways<%= @providers.length %>">
    <div class="filters">
      <%= image_tag('/images/filter.svg') %>
      <input type="text" name="datum" data-action='keyup->compare#searchWrite' placeholder="¿Demasiada información? Filtrá por palabra"/>
    </div>
    <% @providers.each do |p|%>
    <div class="provider-header">
      <%= button_tag "#{svg('trash.svg')}".html_safe, value: p.id, class: 'close', data: { action: "compare#removeFromCompare" } %>
      <% if p.logo.attached? %>
        <%= image_tag p.logo %>
      <% else %>
        <div class="rectangle-div"></div>
      <% end %>
      <h2><%= p.short_name %></h2>
      <div class="web"><%= link_to p.web, "https://#{p.web}", target: "_blank" %></div>
      <% if p.description.present? %>
      <div class="description"><%= p.description.html_safe %></div>
      <% end %>
    </div>
    <% end %>
  </div>
  <% @s.each do |s|%>
  <div class="section" data-controller="section">
    <div class="section-header">
      <div class="header-left">
        <%= button_tag "#{image_tag('/images/arrow.svg')}<h3>#{s['title']}</h3>".html_safe,
        class: 'arrow',
        aria: { expanded: s['name'] == 'sites' ? true : false, controls: "section-#{s['id']}"},
        data: { 
          "section-target": "expand", 
          action: 'click->section#toggleVisibility' 
        }%>
        
          <%= button_tag "#{svg('circle-info.svg')}".html_safe,
          class: 'info',
          aria: { expanded: false, controls: "info-#{s['id']}"},
          data: { 
            "section-target": "infotrigger", 
            action: 'click->section#toggleInfo' 
          }%>
      </div>
      <div class="tag tag-calendar"><%= svg("calendar.svg") %> <%= s['period'] %>/<%= s['year'] %></div>
    </div>
    <!-- Sections -->
    <div id="section-<%= s['id'] %>" class="section-content ways<%= @providers.length %> <%= s['name'] == 'sites' ? 'active' : '' %>" data-section-target="content">
      <div class="section-inner-header">
      <% if s['description'].present? && s['description'] != '' %>
        <div class="description"><%= s['description'].html_safe %></div>
      <% end %>
      <% if ['specialists', 'rrhh'].include? s["name"] %>
        <!-- Section with state filters -->
        <%= select_tag "state", options_for_select( @states ),
        {include_blank: 'Todo el país',
        data: {action: "change->compare#state"}
        } %>
      <% end %>
      </div>
      <!-- Section content -->
      <div class="section-inner-content <%= s["name"]%>">
        <% if ['specialists', 'rrhh'].include? s["name"] %>
          <%= turbo_frame_tag s["name"] do %>
            <%= render partial: s['name'], locals: { section: s }%>
          <% end %>
        <% else %>
          <%= render partial: s['name'], locals: { section: s }%>
        <% end %>
      </div>
    </div>
    <div class="backdrop" data-section-target="infopanel" data-action='click->section#toggleInfo'>
      <div id="info-<%= s['id'] %>" class="info-box">
        <button class="close" data-action='click->section#toggleInfo:stop'>X</button>
        <div class="info-content">
        <% if s['info'].present? %>
          <%= s['info'].gsub('[periodo]', "#{s['period']}/#{s['year']}").html_safe %>
        <% end %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
<% end %>
</div>
